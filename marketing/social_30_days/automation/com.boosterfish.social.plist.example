  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/Users/salimben/Desktop/Projets/spots_app/marketing/social_30_days/automation/state/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/salimben/Desktop/Projets/spots_app/marketing/social_30_days/automation/state/launchd.err.log</string>
</dict>
